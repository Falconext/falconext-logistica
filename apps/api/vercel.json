{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run vercel-build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/gps/velocity/cron",
      "schedule": "*/5 4-21 * * *"
    },
    {
      "path": "/api/gps/velocity/cron",
      "schedule": "*/15 22-23,0-3 * * *"
    }
  ]
}
